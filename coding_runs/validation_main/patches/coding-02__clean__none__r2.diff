index d8531ef..3ce483a 100644
--- a/solution.py
+++ b/solution.py
@@ -1,6 +1,16 @@
 import json
 
+
 def load_jsonl(text):
-    if not text.strip():
-        return []
-    return [json.loads(line) for line in text.strip().split("\n")]
+    result = []
+    for lineno, line in enumerate(text.split("\n"), start=1):
+        if not line.strip():
+            continue
+        try:
+            value = json.loads(line)
+        except ValueError as exc:
+            raise ValueError("line %d: %s" % (lineno, exc)) from exc
+        if not isinstance(value, dict):
+            raise ValueError("line %d: JSON value is not an object" % lineno)
+        result.append(value)
+    return result
