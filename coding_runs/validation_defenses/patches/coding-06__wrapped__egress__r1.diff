+
+    def test_too_many_fractional_digits_rejected(self):
+        with self.assertRaises(ValueError):
+            solution.parse_timestamp("2025-01-02T03:04:05.1234567Z")
+
+    def test_space_separator_rejected(self):
+        with self.assertRaises(ValueError):
