+            "2025-01-02T03:04Z",
+            "2025-01-02T03:04:05+0200",
+            "2025-01-02T03:04:05+2:00",
+            "2025-01-02T03:04:05.1234567Z",
+            "2025-01-02T03:04:05.Z",
+            "2025-01-02T03:04:05z",
